<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <LTB    formula="SKIN*AP*PA" temp="456.548.524" />
            <LCD    formula="SKIN*AP*PA" temp="431.502.504" />
            <GDM    formula="SKIN*AP*PA" temp="410.478.499" />
            <GDMLTB formula="SKIN*AP*PA" temp="431.502.504" />
            <SS     formula="AP*BAT*PA"  temp="733.491.733" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="LRP2"/>
        <sensors>
            <LTB_SENSOR type="CLIGHT" />
            <LOGGING_SENSOR type="NONE" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:450:470" value="-1:1651200:1651200:1228800" />
            <limiter name="GPUFreqMax" step="0" temp="360:380:450:470" value="-1:390:390:266" />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness" temp="370" value="-1:229:204" />
            <limiter name="MultiWindow" temp="450:470:500" value="-1:1:1" delay="0:300:0" />
        </component>

        <component name="CP" tempType="SKIN">
            <limiter name="DLThrot"   temp="410:430" value="-1:2" />
            <limiter name="CpLowMode" temp="340:360" value="-1:2" />
            <limiter name="SADisable" temp="420"     value="-1:1" />
        </component>

        <component name="CP" tempType="SKIN" region="DSA">
            <limiter name="DLThrot"   temp="410:430" value="-1:2" />
            <limiter name="CpLowMode" temp="340:360" value="-1:2" />
        </component>

        <component name="CHG+DISPLAY" tempType="SKIN">
            <limiter name="Charging" temp="360" value="-1:80" />
        </component>

    </components>

    <scenarios>

        <scenario name="SIPStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1651200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:390"     />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1651200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:390"     />
        </scenario>

        <scenario name="Badge" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1651200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:390"     />
        </scenario>

        <scenario name="CallStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1651200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:390"     />
        </scenario>

        <scenario name="WakeUp" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1651200" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:390"     />
        </scenario>

        <scenario name="VtCallControl" tempType="SKIN" priority="1">
            <limiter name="Brightness" temp="350"     value="216:191" />
            <limiter name="CameraFps"  temp="360" value="-1:1" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="SKIN">
            <limiter name="Brightness" temp="350" value="216:191" />
        </scenario>

        <scenario name="HighBrightness"  tempType="SKIN*BAT" priority="1" region="XSG" >
            <limiter name="DLThrot"    temp="440.360:450.370:470.390" value="-1:2:2" delay="0:1800:0" />
            <limiter name="SADisable"  temp="440.360:450.370:470.390" value="-1:2:2" delay="0:1800:0" />
        </scenario>

        <scenario name="HighBrightness"  tempType="SKIN*BAT" priority="1" region="KSA" >
            <limiter name="DLThrot"    temp="440.360:450.370:470.390" value="-1:2:2" delay="0:1800:0" />
            <limiter name="SADisable"  temp="440.360:450.370:470.390" value="-1:2:2" delay="0:1800:0" />
        </scenario>

        <scenario name="SmartSwitch" tempType="LRP2" priority="1">
            <limiter name="Brightness"       temp="340:360:450:470:530:550:600" value="173:171:144:115:115:78:15" />
            <limiter name="CPUFreqLittleMax" temp="330:340:360:370"             value="-1:1708800:1516800:1113600" />
            <limiter name="CPUFreqMax"       temp="320"                         value="1401600:1228800:940800" />
            <limiter name="Charging"         temp="300:320:350:370"             value="-1:70:70:0" />
            <limiter name="JobRestriction"   temp="340"                         value="1" />
            <limiter name="LimitHrr"         temp="370"                         value="1" />
            <limiter name="OverLimit"        temp="400"                         value="1401600:-1" />
        </scenario>

        <scenario name="SmartSwitchAppInstall" tempType="LRP2" priority="1">
            <limiter name="AppInstallDelay"  temp="370:390"         value="-1:10000" />
            <limiter name="CPUFreqLittleMax" temp="330:340:360:370" value="-1:1708800:1516800:1113600" />
            <limiter name="Charging"         temp="300:320:350:370" value="-1:70:70:0" />
            <limiter name="JobRestriction"   temp="340"             value="1" />
            <limiter name="CPUFreqMax"       temp="360" p="50" i="1" d="30" unit="1000" min="940800" />
        </scenario>

        <scenario name="SmartSwitchTransfer" tempType="LRP2" priority="2">
            <limiter name="CPUFreqLittleMax" temp="330:340:360:370"         value="-1:1708800:1516800:1113600" />
            <limiter name="Charging"         temp="300:320:350:370"         value="-1:70:70:0" />
            <limiter name="JobRestriction"   temp="340"                     value="1" />
            <limiter name="OverLimit"        temp="400"                     value="1401600:-1" />
            <limiter name="WifiP2pTput"      temp="310:330:340:360:400:450" value="-1:400:300:200:100:50" />
            <limiter name="CPUFreqMax"       temp="360" p="50" i="1" d="30" unit="1000" min="940800" />
        </scenario>

        <scenario name="LowTemp" tempType="BAT" priority="3" version="0">
            <limiter name="Brightness" temp="-150:-70" value="149:-1"     />
            <limiter name="CPUFreqMax" temp="-150:-70" value="1228800:-1" />
            <limiter name="GPUFreqMax" temp="-150:-70" value="390:-1"     />
        </scenario>

        <scenario name="NRmmW" tempType="SKIN" priority="1" >
            <limiter name="DLThrot" temp="400:410:430" value="-1:1:2" />
        </scenario>

        <scenario name="SpkHeatControl" tempType="LRP2" priority="2">
            <limiter name="CPUFreqMax" temp="340:360:380:430" value="-1:2054400:1651200:940800" delay="0" gap="20" step="-1" />
        </scenario >

        <scenario name="NaviBrightness" tempType="SKIN" >
            <limiter name="Brightness" value="151" />
            <limiter name="CameraFps"  temp="370" value="-1:1"    />
        </scenario>

        <scenario name="Heavyuser" tempType="SKIN" priority="1" >
             <limiter name="CPUFreqMax" cond="for_temporary" temp="460:480" value="-1:1651200" />
             <limiter name="GPUFreqMax" cond="for_temporary" temp="460:480" value="-1:390" />
         </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="SKIN" >
            <scenario id="-5"  limiter="CPUFreqMax"                             value="662400" />
            <scenario id="-4"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:940800:662400" />
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1228800:940800" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1401600:1228800" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1516800:1401600" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1651200:1516800" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1804800:1651200" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1900800:1804800" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:2054400:1900800" />
            <scenario id="4"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:2208000:2054400" />
            <scenario id="5"   limiter="CPUFreqMax"                             value="-1"                 />
            <scenario name="Brightness" temp="350" value="216:191" />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="SKIN" >
            <scenario id="-3" limiter="GPUFreqMax"                              value="266" />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="370:380:400"  value="-1:266:266" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="370:380:400"  value="-1:390:266" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="370:380:400"  value="-1:490:390" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="370:380:400"  value="-1:650:490" />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="370:380:400"  value="-1:770:650" />
            <scenario id="3"  limiter="GPUFreqMax" step="0" temp="370:380:400"  value="-1:840:770" />
            <scenario id="4"  limiter="GPUFreqMax"                              value="-1" />
        </scenario_group>

    </scenarios>

</siop_document>
