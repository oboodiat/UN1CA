<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (default, complex?)>
<!ELEMENT default (component+)>
<!ELEMENT complex (component+)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <LTB    formula="AP*SKIN*PA"  temp="470.470.480" />
            <LCD    formula="AP*SKIN*PA"  temp="450.450.460" />
            <GDM    formula="AP*SKIN*PA"  temp="435.440.440" />
            <GDMLTB formula="AP*SKIN*PA"  temp="450.450.460" />
            <SS     formula="AP*BAT*PA"  temp="695.515.780" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <Skin type="LRP2"/>
        <sensors>
            <LTB_SENSOR type="CLIGHT" />
            <LOGGING_SENSOR type="NONE" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="SKIN" >
            <limiter name="CPUFreqMax" step="0" temp="360:380:450:470" value="-1:1766400:1766400:1056000" />
            <limiter name="GPUFreqMax" step="0" temp="360:380:450:470" value="-1:600:600:465" />
        </component>

        <component name="DISPLAY" tempType="SKIN">
            <limiter name="Brightness"  temp="370"         value="-1:229:180" />
            <limiter name="MultiWindow" temp="450:470:500" value="-1:1:1" delay="0:300:0" />
        </component>

        <component name="CHG+DISPLAY" tempType="SKIN">
            <limiter name="Charging" temp="350" value="-1:70" />
        </component>

    </components>

    <scenarios>

        <scenario name="ScreenOffInCall" tempType="SKIN" priority="1" >
            <limiter name="Charging" value="70" />
        </scenario>

        <scenario name="SIPStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1766400" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:600"  />
        </scenario>

        <scenario name="AppStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1766400" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:600"  />
        </scenario>

        <scenario name="Badge" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1766400" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:600"  />
        </scenario>

        <scenario name="CallStart" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1766400" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:600"  />
        </scenario>

        <scenario name="WakeUp" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="450" value="-1:1766400" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="450" value="-1:600"  />
        </scenario>

        <scenario name="VtCallControl" tempType="SKIN" priority="1">
            <limiter name="Brightness" temp="350:370" value="216:191" />
            <limiter name="CameraFps"  temp="360" value="-1:1" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="SKIN" priority="1" >
            <limiter name="Brightness" temp="350:370" value="216:191" />
        </scenario>

        <scenario name="Navigation" tempType="SKIN" priority="1" >
            <limiter name="Brightness" temp="350" value="173" />
            <limiter name="CameraFps"  temp="370" value="-1:1"    />
        </scenario>

        <scenario name="LowTemp" tempType="BAT" priority="3">
            <limiter name="Brightness" temp="-150:-70" value="149:-1" />
            <limiter name="CPUFreqMax" temp="-150:-70" value="1344000:-1" />
            <limiter name="GPUFreqMax" temp="-150:-70" value="320:-1" />
            <limiter name="OverLimit"                  value="-1" />
        </scenario>

        <scenario name="Heavyuser" tempType="SKIN" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="460:480" value="-1:1766400" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="460:480" value="-1:600" />
        </scenario>

        <scenario name="SmartSwitch" tempType="LRP2" priority="1">
            <limiter name="Brightness" temp="340:360:450:470:530:550:600" value="173:171:144:115:115:78:15" />
            <limiter name="CPUFreqLittleMax" temp="330:340:360:370" value="-1:1804800:1516800:1190400" />
            <limiter name="CPUFreqMax" temp="320" value="1344000:1056000:950400" />
            <limiter name="Charging" temp="300:320:350:370" value="-1:70:70:0" />
            <limiter name="JobRestriction" temp="340" value="1" />
            <limiter name="LimitHrr" value="1" temp="370" />
            <limiter name="OverLimit" temp="400" value="1344000:-1" />
        </scenario>
        <scenario name="SmartSwitchAppInstall" tempType="LRP2" priority="1">
            <limiter name="AppInstallDelay" temp="370:390" value="-1:10000" />
            <limiter name="CPUFreqLittleMax" temp="330:340:360:370" value="-1:1804800:1516800:1190400" />
            <limiter name="CPUFreqMax" tempType="SKIN" temp="360" p="50" i="1" d="30" unit="1000" min="950400" delay="0" gap="20" step="-1"/>
            <limiter name="Charging" temp="300:320:350:370" value="-1:70:70:0" delay="0" gap="20" step="-1"/>
            <limiter name="JobRestriction" temp="340" value="1" delay="0" gap="20" step="-1"/>
        </scenario>
        <scenario name="SmartSwitchTransfer" tempType="LRP2" priority="2">
            <limiter name="CPUFreqLittleMax" temp="330:340:360:370" value="-1:1804800:1516800:1190400" />
            <limiter name="CPUFreqMax" tempType="SKIN" temp="360" p="50" i="1" d="30" unit="1000" min="950400" delay="0" gap="20" step="-1"/>
            <limiter name="Charging" temp="300:320:350:370" value="-1:70:70:0" />
            <limiter name="JobRestriction" temp="340" value="1" />
            <limiter name="OverLimit" temp="400" value="1344000:-1" delay="0" gap="20" step="-1"/>
            <limiter name="WifiP2pTput" temp="310:330:340:360:400:450" value="-1:400:300:200:100:50" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="SKIN" >
            <scenario id="-7"  limiter="CPUFreqMax"                              value="950400" />
            <scenario id="-6"  limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:1056000:950400"   />
            <scenario id="-5"  limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:1056000:950400"   />
            <scenario id="-4"  limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:1056000:950400"   />
            <scenario id="-3"  limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:1056000:950400"  />
            <scenario id="-2"  limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:1344000:1056000" />
            <scenario id="-1"  limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:1766400:1344000" />
            <scenario id="0"   limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:2208000:1766400" />
            <scenario id="1"   limiter="CPUFreqMax"  step="0" temp="370:380:400" value="-1:2400000:2208000" />
            <scenario id="2"   limiter="CPUFreqMax"                              value="-1"                 />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="SKIN" >
            <scenario id="-4" limiter="GPUFreqMax"                             value="320" />
            <scenario id="-3" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:320:320"   />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:465:320"   />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:600:465"   />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:785:600"   />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:1025:785"  />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:1114:1025" />	
            <scenario id="3"  limiter="GPUFreqMax"                             value="-1"           />
        </scenario_group>

    </scenarios>

</siop_document>
